# ---- عمومی ----
NODE_ENV=development
LOG_LEVEL=info

# ---- دیتابیس ----
# اتصال اصلی (نوشتن + کارهای Worker)
DATABASE_URL=postgres://pos_app:change_me@localhost:5432/pos_support
# اختیاری: Read Replica برای کوئری‌های آماری. اگر خالی باشد از DATABASE_URL استفاده می‌شود
READ_DATABASE_URL=
DB_WRITE_POOL_MAX=10
DB_READ_POOL_MAX=10
# سقف زمان کوئری روی pool خواندن (میلی‌ثانیه)
DB_READ_STATEMENT_TIMEOUT_MS=15000
# کوئری کندتر از این مقدار لاگ و ثبت می‌شود
SLOW_QUERY_MS=500

# ---- API ----
API_HOST=0.0.0.0
API_PORT=3000
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=10

# ---- احراز هویت (حداقل ۳۲ کاراکتر) ----
JWT_SECRET=change_me_to_a_long_random_string_32chars_min
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ---- ذخیره‌سازی فایل ----
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
UPLOAD_MAX_MB=100

# ---- ایمپورت و Worker ----
IMPORT_MAX_ROWS=1100000
IMPORT_VACUUM_THRESHOLD=200000
PGBOSS_SCHEMA=pgboss
# تعداد jobهای هم‌زمان در هر پروسه‌ی Worker (ایمپورت‌ها سنگین‌اند)
WORKER_CONCURRENCY=1
